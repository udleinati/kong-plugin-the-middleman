# servroot is typically the nginx/Kong workingdirectory when testing
servroot

# packed distribution format for LuaRocks
*.rock
/luarocks
/lua
/lua_modules
/.luarocks

# vendored Kong test runner (cloned by `make pongo`)
/.pongo/kong-pongo

# busted coverage / test artifacts
luacov.*.out
luacov.stats.out
luacov.report.out
